<!DOCTYPE html>
<html lang="ro">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CyberSecurity & Linux Hub</title>
    <style>
        /* Resetări de bază */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Courier New', Courier, monospace;
        }

        body {
            background-color: #000;
            color: #00ff00;
            overflow-x: hidden;
        }

        /* Canvas-ul pentru codurile căzătoare */
        #matrixCanvas {
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            z-index: -1; /* Trimite animația în spatele textului */
        }

        /* Structura paginii */
        .wrapper {
            display: flex;
            min-height: 100vh;
        }

        /* Meniu Lateral cu efect Glow */
        nav {
            width: 250px;
            background: rgba(0, 0, 0, 0.85);
            border-right: 2px solid #ff003c;
            padding: 20px;
            position: fixed;
            height: 100vh;
            box-shadow: 5px 0px 15px rgba(255, 0, 60, 0.3);
        }

        nav h2 {
            color: #ff003c;
            font-size: 22px;
            margin-bottom: 30px;
            text-transform: uppercase;
            letter-spacing: 2px;
            text-shadow: 0 0 8px #ff003c;
        }

        nav ul {
            list-style: none;
        }

        nav ul li {
            margin-bottom: 20px;
        }

        nav ul li a {
            color: #00ff00;
            text-decoration: none;
            font-size: 16px;
            display: block;
            transition: all 0.3s ease;
        }

        /* Animație la trecerea cu mouse-ul peste link-uri */
        nav ul li a:hover {
            color: #ffffff;
            padding-left: 10px;
            text-shadow: 0 0 10px #00ff00, 0 0 20px #00ff00;
        }

        /* Zona de conținut principal */
        main {
            margin-left: 250px;
            padding: 40px;
            width: calc(100% - 250px);
            background: rgba(0, 0, 0, 0.4); /* Permite vizualizarea codului din spate */
        }

        header h1 {
            color: #ff003c;
            font-size: 36px;
            text-transform: uppercase;
            margin-bottom: 10px;
            text-shadow: 0 0 10px #ff003c;
        }

        header p {
            color: #888;
            margin-bottom: 40px;
        }

        /* Secțiuni stilizate ca niște terminale */
        .card {
            background: rgba(10, 15, 10, 0.85);
            border: 1px solid #00ff00;
            border-radius: 5px;
            padding: 25px;
            margin-bottom: 30px;
            box-shadow: 0 0 15px rgba(0, 255, 0, 0.1);
        }

        .card h2 {
            color: #00ff00;
            margin-bottom: 15px;
            text-shadow: 0 0 5px #00ff00;
        }

        .card p {
            color: #ddd;
            line-height: 1.6;
            margin-bottom: 15px;
        }

        /* Tabel stilizat în stil Cyber */
        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 20px;
            background: rgba(0, 0, 0, 0.6);
        }

        th, td {
            border: 1px solid #ff003c;
            padding: 12px;
            text-align: left;
        }

        th {
            background-color: #ff003c;
            color: #fff;
            text-transform: uppercase;
            text-shadow: 0 0 5px #fff;
        }

        tr:hover {
            background: rgba(0, 255, 0, 0.1);
        }

        code {
            background: #222;
            padding: 3px 8px;
            border-radius: 3px;
            color: #ffaa00;
        }
    </style>
</head>
<body>

    <!-- Fundalul interactiv cu coduri căzătoare -->
    <canvas id="matrixCanvas"></canvas>

    <div class="wrapper">
        <!-- Meniu Navigare -->
        <nav>
            <h2>Navigare</h2>
            <ul>
                <li><a href="#">Acasă & Linux</a></li>
                <li><a href="#">Kali Linux</a></li>
                <li><a href="#">BlackArch Linux</a></li>
                <li><a href="#">Hack Tools & Comenzi</a></li>
            </ul>
        </nav>

        <!-- Conținut Site -->
        <main>
            <header>
                <h1>CyberSecurity & Cyber-Exploration</h1>
                <p>Sisteme avansate și unelte de analiză a securității cibernetice.</p>
            </header>

            <section class="card">
                <h2>Ce este Linux?</h2>
                <p>Linux este nucleul unui sistem de operare gratuit și open-source. Spre deosebire de sistemele comerciale închise, Linux oferă utilizatorului control total asupra rețelei, proceselor de sistem și gestionării memoriei.</p>
                <p>Din acest motiv, aproape toate uneltele profesionale de hacking sunt dezvoltate nativ pentru distribuțiile de Linux.</p>
            </section>

            <section class="card">
                <h2>Hack Tools & Comenzi Esențiale</h2>
                <table>
                    <thead>
                        <tr>
                            <th>Unealtă</th>
                            <th>Scop Principal</th>
                            <th>Exemplu Comandă</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td><strong>Nmap</strong></td>
                            <td>Scanarea porturilor și descoperirea vulnerabilităților.</td>
                            <td><code>nmap -sV -O 192.168.1.1</code></td>
                        </tr>
                        <tr>
                            <td><strong>Metasploit</strong></td>
                            <td>Platformă pentru testarea și executarea exploit-urilor.</td>
                            <td><code>msfconsole</code></td>
                        </tr>
                        <tr>
                            <td><strong>Hydra</strong></td>
                            <td>Atacuri de tip brute-force pentru spargerea parolelor.</td>
                            <td><code>hydra -l admin -P pass.txt ssh://192.168.1.5</code></td>
                        </tr>
                    </tbody>
                </table>
            </section>
        </main>
    </div>

    <!-- Script JavaScript pentru Animația Matrix -->
    <script>
        const canvas = document.getElementById('matrixCanvas');
        const ctx = canvas.getContext('2d');

        // Setează dimensiunea canvas-ului la mărimea ferestrei
        function resizeCanvas() {
            canvas.width = window.innerWidth;
            canvas.height = window.innerHeight;
        }
        resizeCanvas();
        window.addEventListener('resize', resizeCanvas);

        // Caracterele folosite pentru ploaia de cod (Matrix)
        const katakana = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789アイウエオカキクケコサシスセソタチツテト';
        const alphabet = katakana.split('');

        const fontSize = 16;
        // Calculează câte coloane încap pe ecran
        const columns = canvas.width / fontSize;

        // Vector pentru a reține poziția Y curentă a fiecărei coloane
        const rainDrops = [];
        for (let x = 0; x < columns; x++) {
            rainDrops[x] = 1;
        }

        // Funcția de desenare a animației
        function drawMatrix() {
            // Creează un efect de dâră (trail) prin aplicarea unui fundal negru foarte transparent
            ctx.fillStyle = 'rgba(0, 0, 0, 0.05)';
            ctx.fillRect(0, 0, canvas.width, canvas.height);

            ctx.fillStyle = '#00ff00'; // Culoarea textului care cade
            ctx.font = fontSize + 'px monospace';

            for (let i = 0; i < rainDrops.length; i++) {
                // Alege un caracter la întâmplare
                const text = alphabet[Math.floor(Math.random() * alphabet.length)];
                
                // Afișează caracterul pe ecran
                const x = i * fontSize;
                const y = rainDrops[i] * fontSize;
                ctx.fillText(text, x, y);

                // Dacă textul trece de marginea de jos, îl resetăm în sus în mod aleatoriu
                if (y > canvas.height && Math.random() > 0.975) {
                    rainDrops[i] = 0;
                }
                rainDrops[i]++;
            }
        }

        // Rulează funcția de desenare la fiecare 30 milisecunde
        setInterval(drawMatrix, 30);
    </script>
</body>
</html>
